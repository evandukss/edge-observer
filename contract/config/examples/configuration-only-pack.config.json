{
  "version": "observer.config/draft",
  "observer": {
    "log": "stdout",
    "directory": "/var/lib/observer",
    "approved_output_bound_mib": 64,
    "admitted_event_limit": 16384,
    "state_every_seconds": 30
  },
  "observation_scope": {
    "targets": [
      {
        "name": "api-server",
        "match": {
          "exe": "/usr/bin/php",
          "args": [
            "/srv/api/main.php"
          ]
        },
        "descendants": {
          "existing": true,
          "future": true,
          "boundary": "exec_ends_the_grant",
          "root_exit": "survivors_keep_their_grants",
          "replacement": "needs_restart"
        }
      }
    ],
    "exclude": [],
    "libraries": []
  },
  "traffic_scope": {
    "rules": [
      {
        "targets": [],
        "direction": "any",
        "local_ports": [],
        "remote_ports": []
      }
    ]
  },
  "retention_and_export": {
    "retain_plaintext": true,
    "export_sinks": []
  },
  "packs": [
    "reversed-masking"
  ],
  "sinks": [
    {
      "name": "account",
      "kind": "local_account"
    }
  ],
  "pipelines": [
    {
      "name": "exchanges",
      "input": "reconstruction",
      "slots": [
        {
          "name": "mark",
          "implementation": "replace-header-values",
          "configuration": {
            "headers": [
              "authorization"
            ],
            "value": "withheld-by-operator"
          },
          "on_failure": "drop_and_account"
        },
        {
          "name": "limit",
          "implementation": "truncate-header-values",
          "configuration": {
            "headers": [
              "authorization"
            ],
            "length": 8
          },
          "on_failure": "drop_and_account"
        }
      ],
      "sinks": [
        "account"
      ],
      "queues": []
    }
  ],
  "subscribers": [],
  "policy": []
}
