{
  "purpose": "a replacement that accepts what reaches its slot and produces a type the sink does not accept",
  "configuration": {
    "version": "observer.config/draft",
    "observer": {
      "log": "stdout",
      "directory": "/var/lib/observer",
      "spool_bound_mib": 64,
      "state_every_seconds": 30
    },
    "observation_scope": {
      "targets": [
        {
          "name": "api-server",
          "match": {
            "exe": "/usr/bin/php",
            "args": [
              "/srv/api/main.php"
            ]
          },
          "descendants": {
            "existing": true,
            "future": true,
            "boundary": "exec_ends_the_grant",
            "root_exit": "survivors_keep_their_grants",
            "replacement": "needs_restart"
          }
        }
      ],
      "exclude": [],
      "libraries": []
    },
    "traffic_scope": {
      "rules": [
        {
          "targets": [],
          "direction": "any",
          "local_ports": [],
          "remote_ports": []
        }
      ]
    },
    "retention_and_export": {
      "retain_plaintext": true,
      "export_sinks": []
    },
    "packs": [
      "swap"
    ],
    "sinks": [
      {
        "name": "summary",
        "kind": "stdout_summary"
      }
    ],
    "pipelines": [
      {
        "name": "exchanges",
        "input": "connection",
        "slots": [
          {
            "name": "redact",
            "implementation": "connection-summariser",
            "on_failure": "drop_and_account"
          }
        ],
        "sinks": [
          "summary"
        ],
        "queues": [
          {
            "name": "exchanges-out"
          }
        ]
      }
    ],
    "subscribers": [],
    "policy": []
  },
  "manifests": [
    {
      "name": "swap",
      "content": {
        "version": "observer.pack/draft",
        "name": "swap",
        "pack_version": "1.0.0",
        "components": [
          {
            "interface": "observer.component/draft",
            "name": "connection-annotator",
            "version": "1.0.0",
            "role": "processor",
            "execution": "external",
            "input": {
              "types": [
                "connection"
              ],
              "delivery": "record"
            },
            "output": {
              "records": [
                "reconstruction"
              ],
              "derived": [],
              "suppression": false,
              "findings": false
            },
            "state": "none",
            "ordering": {
              "records": "none",
              "after": [],
              "before": []
            },
            "lifecycle": {
              "startup": "ignored",
              "configuration_change": "ignored",
              "stream_closure": "ignored",
              "flush": "ignored",
              "shutdown": "ignored"
            },
            "failures": [
              "record_error",
              "fatal"
            ]
          }
        ],
        "pipelines": [],
        "replacements": [
          {
            "pipeline": "exchanges",
            "slot": "redact",
            "implementation": "connection-annotator"
          }
        ],
        "policy": []
      }
    }
  ],
  "expected": {
    "outcome": "composition_refused",
    "structural": [],
    "composition": [
      {
        "document": "manifest:swap",
        "subject": "replacement:exchanges.redact",
        "reason": "replacement_incompatible"
      }
    ]
  }
}
