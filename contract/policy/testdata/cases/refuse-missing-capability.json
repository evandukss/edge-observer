      {"declaration": "r-ghost-queue", "disposition": "refuse_activation", "reason": "missing_capability", "pipelines": ["capture", "diagnostics"]},
      {"declaration": "c-enricher", "disposition": "refuse_activation", "reason": "missing_capability", "pipelines": ["capture", "diagnostics"]}
